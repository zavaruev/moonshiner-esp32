/*
 * credentials.h.example -> copy to main/credentials.h (gitignored) and fill in.
 * The native firmware uses this instead of the ESPHome secrets.yaml.
 */
#ifndef MOONSHINER_CREDENTIALS_H
#define MOONSHINER_CREDENTIALS_H

#define MS_WIFI_SSID      "your-wifi-ssid"
#define MS_WIFI_PASSWORD  "your-wifi-password"
#define MS_AP_PASSWORD    "your-fallback-ap-password"
#define MS_WEB_USER       "your-web-username"
#define MS_WEB_PASSWORD   "your-web-password"
#define MS_MCP_API_KEY    "your-mcp-bearer-token"

#endif /* MOONSHINER_CREDENTIALS_H */
